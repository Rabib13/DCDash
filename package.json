{
  "name": "dc-dash",
  "version": "1.0.0",
  "description": "Map of AI data centers with sourced community impact facts",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "npm run validate && node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "validate": "node scripts/validate-data.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check-links": "node scripts/check-links.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rabib13/DCDash.git"
  },
  "bugs": {
    "url": "https://github.com/Rabib13/DCDash/issues"
  },
  "homepage": "https://github.com/Rabib13/DCDash#readme",
  "dependencies": {
    "maplibre-gl": "6.17.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "typescript": "5.8.3",
    "vitest": "5.1.2"
  },
  "private": true
}
